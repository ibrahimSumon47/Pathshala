#!/bin/sh
# Author guard: nothing leaves this machine unless every outgoing commit belongs to the
# owner and carries no tool credit. The rule itself lives in scripts/check-commits.mjs so
# the hook and CI cannot drift apart.
set -u

zero='0000000000000000000000000000000000000000'
ranges=''
scan_all=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # A branch the remote has never seen: the whole history is new to it.
    scan_all=1
  else
    ranges="$ranges $remote_sha..$local_sha"
  fi
done

if [ "$scan_all" -eq 1 ]; then
  exec node scripts/check-commits.mjs --all
fi

[ -z "$ranges" ] && exit 0

# shellcheck disable=SC2086
exec node scripts/check-commits.mjs $ranges
