# Copy to .env.local. Never commit the filled file.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: enables the Google button on /sign-in when both values are present.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: when set, accounts are read from MongoDB instead of the public demo list.
MONGODB_URI=
MONGODB_DB=pathshala

# Demo accounts are always on in development. In production set this to true to show
# them, or false to hide them; anything else leaves them off.
DEMO_AUTH=true

# Public origin used for payment return URLs. Locally the Next dev server is on 59800.
APP_URL=http://localhost:59800

# Stripe sandbox. Leave blank until the owner adds test keys; checkout shows PayBridge only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayBridge sandbox gateway. Values live in apps/web/.env.local and apps/paybridge/.env.local.
PAYBRIDGE_BASE_URL=http://localhost:59801
PAYBRIDGE_API_KEY=
PAYBRIDGE_WEBHOOK_SECRET=
PAYBRIDGE_DASHBOARD_PASSWORD=
