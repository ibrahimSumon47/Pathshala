{
  "name": "@pathshala/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "bundle": "esbuild api/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=api/index.cjs --external:@nestjs/microservices --external:@nestjs/websockets --external:class-validator --external:class-transformer --external:cache-manager --external:ioredis --external:kerberos --external:@mongodb-js/zstd --external:@aws-sdk/credential-providers --external:gcp-metadata --external:snappy --external:socks --external:aws4 --external:mongodb-client-encryption",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@pathshala/db": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
