# PayBridge sandbox gateway. Test mode only; no real money moves.
# Use the same memory MongoDB as the web app locally, or a separate Atlas database.
MONGODB_URI=mongodb://127.0.0.1:27018/pathshala
# Merchant API key the Pathshala web app sends as a bearer token.
PAYBRIDGE_API_KEY=
# Secret used to sign payment.succeeded / payment.refunded webhooks.
PAYBRIDGE_WEBHOOK_SECRET=
# Enables creating the demo merchant on the first authenticated API call.
PAYBRIDGE_ALLOW_BOOTSTRAP=true
# Dashboard login and signed cookie secret.
PAYBRIDGE_DASHBOARD_PASSWORD=
PAYBRIDGE_DASHBOARD_SECRET=
